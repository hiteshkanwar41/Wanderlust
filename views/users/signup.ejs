<% layout("/layouts/boilerplate.ejs") %>

<div class="row mt-3">
    <h3 class="col-6 offset-3">Signup on Wanderlust</h3>
    <div class="col-6 offset-3">
        
        <form method="POST" action="/signup" novalidate class="needs-validation" id="signupForm">

            <div class="mb-3 mt-3">
                <label for="username" class="form-label" >Username</label> 
                <input name="username" placeholder="Enter username" type="text" class="form-control" id="username" required>
               <div class="valid-feedback">Looks good!</div>
                <div class="invalid-feedback">Please enter a valid username</div>
            </div>
            <div class="mb-3 mt-3">
                <label for="email" class="form-label" >Email</label> 
                <input name="email" placeholder="Enter your emailId" type="email" class="form-control" id="email" required>
                <div id="emailFeedback"></div>
            </div>
            <div class="mb-3 mt-3">
                <label for="password" class="form-label" >Password</label> 
                <input name="password" placeholder="Enter your password" type="password" class="form-control" id="password" required>
                <div class="valid-feedback">Looks good!</div>
                <div class="invalid-feedback">Please enter a valid password</div>
            </div>
            <div>
                <a class="button google btn btn btn-outline-success " href="/login/federated/google">Sign in with Google</a>
            </div>
            <button class="btn btn-success mb-3 mt-3">Submit</button>

        </form>
    </div>
</div>