<% layout("/layouts/boilerplate.ejs") %>
<% block('head').append('<link rel="stylesheet" href="/css/booking.css">') %>

<div class="row">
    <div class="col col-lg-10 mx-auto">
        <div class="listing-header align-items-start mb-3 ms-3 me-3 mt-3">
            <div>
                <h2>My Bookings</h2>
                <p>Track all your upcoming and past stays</p>
            </div>
        </div>

    </div>
</div>

<div class="row mt-3">
    <div class="col col-lg-10 mx-auto">
        
        <div class="info-cards">
            <div class="info-card">
                <div class="info-icon">
                    <div class="icon green">
                        <i class="fa-solid fa-calendar-days"></i>
                    </div>
                </div>
                <div class="info-text">
                    <p>Upcoming stays</p>
                    <h4 style="color:#16a34a;"><%=info.upcomingStays%></h4>
                </div>
            </div>
            <!-- Completed -->
        <div class="info-card">
                <div class="info-icon">
                    <div class="icon blue">
                        <i class="fa-solid fa-check"></i>
                    </div>
                </div>
                <div class="info-text">
                    <p>Completed</p>
                    <h4 style="color:#2563eb;"><%=info.completedTrips%></h4>
                </div>
            </div>
              <!-- Current Stays -->
            <div class="info-card">
                <div class="info-icon">
                    <div class="icon teal">
                        <i class="fa-solid fa-bed"></i>
                    </div>
                </div>
                <div class="info-text">
                    <p>Ongoing Stays</p>
                    <h4 style="color: #0f766e;"><%=info.currentStays%></h4>
                </div>
            </div>
            <!-- Total Bookings -->
            <div class="info-card">
                <div class="info-icon">
                    <div class="icon purple">
                        <i class="fa-solid fa-book"></i>
                    </div>
                </div>
                <div class="info-text">
                    <p>Total Bookings</p>
                    <h4 style="color:#7c3aed;"><%=info.totalBookings%></h4>
                </div>
            </div>
            <!-- Total Spent -->
            <div class="info-card">
                <div class="info-icon">
                    <div class="icon orange">
                        <i class="fa-solid fa-wallet"></i>
                    </div>
                </div>
                <div class="info-text">
                    <p>Total Spent</p>
                    <h4 style="color:#ea580c;">₹<%=info.totalSpent%>K</h4>
                </div>
            </div>
        </div>
         
    </div>
</div>
<!-- //this filter value is send by listing.js in route section as we retrieved req.query.filter and then while rendering 
//sended this filter so as to use here for showing active state. -->
<div class="row mt-4">
    <div class="col-lg-10 mx-auto">
        <div class="booking-filters">

            <a href="/listings/booking"
            class="filter-btn <%= !filter ? 'active' : '' %>">
                All Bookings
            </a>

            <a href="/listings/booking?filter=upcoming"
            class="filter-btn <%= filter==='upcoming' ? 'active' : '' %>">
                Upcoming
            </a>

            <a href="/listings/booking?filter=completed"
            class="filter-btn <%= filter==='completed' ? 'active' : '' %>">
                Completed
            </a>

            <a href="/listings/booking?filter=current"
            class="filter-btn <%= filter==='current' ? 'active' : '' %>">
                Ongoing Stays
            </a>

        </div>
    </div>
</div>



<div class="row mt-4">
    <div class="col-lg-10 mx-auto">
        <% if(bookings.length!=0){%>
            <% for (const booking of bookings){  %>
            <div class="booking-card row g-0">

            <!-- Image -->
            <div class="col-lg-4">
                <div class="booking-img">
                    <img src="<%= booking.listing.image.url %>" alt="img">
                </div>
            </div>

            <!-- Details -->
            <div class="col-lg-8">
                <div class="booking-details">

                    <div class="d-flex justify-content-between align-items-start ">
                        <div class="booking-h">
                            <h6><%= booking.listing.title%></h6>
                            <p>
                                <i class="fa-solid fa-location-dot"></i>
                                <%= booking.listing.neighbourhood%>, <%= booking.listing.city%>
                            </p>
                        </div>

                        <span class="status confirmed">
                            <i class="fa-regular fa-circle-check"></i>
                            Confirmed
                        </span>
                    </div>

                    <div class="booking-info">

                        <div class="booking-subinfo">
                            <p><i class="fa-regular fa-calendar"></i> Check-in</p>
                            <h6><%= booking.checkIn.toLocaleDateString("en-GB")%></h6>
                        </div>

                        <div class="booking-subinfo">
                            <p><i class="fa-regular fa-calendar"></i> Check-out</p>
                            <h6><%= booking.checkOut.toLocaleDateString("en-GB")%></h6>
                        </div>

                        <div class="booking-subinfo">
                            <p><i class="fa-solid fa-user-group"></i> Guests</p>
                            <h6><%= booking.guests%> Guests</h6>
                        </div>

                        <div class="booking-subinfo">
                            <p><i class="fa-regular fa-moon"></i> Nights</p>
                            <% 
                               let nights = Math.round(
                                    (new Date(booking.checkOut) - new Date(booking.checkIn))
                                    / (1000 * 60 * 60 * 24)
                                );
                            %>
                            <h6><%= nights%> Nights</h6>
                        </div>

                        <div class="booking-subinfo">
                            <p>Total Price</p>
                            <h6 class="price">₹<%= booking.totalPrice%> </h6>
                        </div>

                    </div>

                    <div class="booking-footer">
                        <p>Booked On <span style="font-weight: 600; margin-left: 2px;"><%= booking.createdAt.toDateString()%></span></p>

                        <div class="buttons">
                            <a href="/listings/<%= booking.listing._id %>" class="btn btn-outline-dark">View Listing</a> 
                            <button class="btn btn-outline-danger">
                                Cancel Booking
                            </button>
                        </div>
                    </div>

                </div>
            </div>

        </div>
        <% } %>
        <% } 
        else { %>

            <div class="empty-bookings">

                <img src="https://res.cloudinary.com/lxlylk0n/image/upload/v1792675849/noBooking_rsivwl.png" alt="No bookings">

                <h2>
                    <% if (filter === "upcoming") { %>
                        You don't have any upcoming stays
                    <% } else if (filter === "completed") { %>
                        You don't have any completed stays
                    <% } else if (filter === "current") { %>
                        You don't have any ongoing stays
                    <% } else { %>
                        You don't have any bookings
                    <% } %>
                </h2>

                <p>
                    <% if (filter === "upcoming") { %>
                        Your upcoming stays will appear here once you make a booking.
                    <% } else if (filter === "completed") { %>
                        Your completed stays will appear here after your trips.
                    <% } else if (filter === "current") { %>
                        Your currently active stays will appear here.
                    <% } else { %>
                        Once you make a reservation, your bookings will appear here.
                    <% } %>
                </p>

                <a href="/listings" class="btn explore-btn">
                    Explore stays
                </a>

            </div>

        <% } %>
        
        
    </div>
</div>
   


<script>
     const message = sessionStorage.getItem("flashSuccess");

    if (message) {
        window.flashSuccess = message;
        sessionStorage.removeItem("flashSuccess");
    }
</script>