<%# Razorpay Checkout SDK:%>
<script src="https://checkout.razorpay.com/v1/checkout.js"></script>


<script>
    
    const checkIn=document.getElementById("checkIn");
    const checkOut=document.getElementById("checkOut");
    const guests=document.getElementById("guests");
    const price=document.getElementById("price");
    const priceText=document.getElementById("price-text");
    
    let pricePerNightElement=document.getElementById("pricePerNight");
    let pricePerNight = Number(document.getElementById("pricePerNight").dataset.price);
    
    //currency item is set in index.js page
    const currency = sessionStorage.getItem("currency") || "USD";
    
    if (currency === "INR") {
        const conversionRate=Number(sessionStorage.getItem("conversionRate"));
        pricePerNight=Number(pricePerNight.toFixed(2)) ;
        pricePerNight=pricePerNight*conversionRate;
        pricePerNightElement.innerHTML = `₹ ${pricePerNight.toFixed(2)}<span>/ night</span>`;
    }else{
        console.log(pricePerNight);
        console.log(typeof pricePerNight);
        pricePerNight=Number(pricePerNight.toFixed(2)) ;
        console.log(pricePerNight);
        console.log(typeof pricePerNight);
        pricePerNightElement.innerHTML = `$ ${pricePerNight.toFixed(2)}<span>/ night</span>`;
    }

    const today = new Date().toISOString().split("T")[0];
    const twoDays = 2 * 24 * 60 * 60 * 1000;
    const dayAfterTomorrow = new Date(Date.now()+twoDays).toISOString().split("T")[0];
    
    checkIn.min = today;
    checkOut.min = today;
    if(sessionStorage.getItem("checkOut") && sessionStorage.getItem("checkIn")){
        checkIn.value=sessionStorage.getItem("checkIn");
        checkOut.value=sessionStorage.getItem("checkOut");
    }else{
        checkIn.value=today;
        checkOut.value=dayAfterTomorrow;
    }
    
    
    function animate(element, startval,targetValue, symbol="",duration = 1000) {
    let startTimestamp = null;
    const startValue = startval; // Or current value if you want to animate from existing

    function step(timestamp) {
        if (!startTimestamp) startTimestamp = timestamp;
        const progress = Math.min((timestamp - startTimestamp) / duration, 1);
        
        // Calculate the current value
        const currentValue = startValue + (targetValue - startValue) * progress;
        
        // Update the UI
       if (symbol === "$" || symbol === "₹") {
            const locale = symbol === "₹" ? "en-IN" : "en-US";

            element.textContent =
                symbol +
                currentValue.toLocaleString(locale, {
                    minimumFractionDigits: 2,
                    maximumFractionDigits: 2,
                });
        }else{
            element.textContent = currentValue.toLocaleString()+symbol;
        }

        if (progress < 1) {
            window.requestAnimationFrame(step);
        }
    }
    window.requestAnimationFrame(step);
    }
    
    let prevPrice=0;
    function updateBooking() {
    if (!checkIn.value || !checkOut.value) return;
    //Date objects internally store time as the number of milliseconds since January 1, 1970 (UTC),
    const inDate = new Date(checkIn.value);
    const outDate = new Date(checkOut.value);
    
    const nights = (outDate - inDate) / (1000 * 60 * 60 * 24);

    if (nights <= 0) {
        alert("Check-out date must be after check-in date.");
        return;
    }


    if(nights){
        
       
        // price.innerText = `$${pricePerNight * nights}`;
        let symbol=currency==="USD"?"$":"₹";
        animate(price,prevPrice,pricePerNight * nights,symbol);
        prevPrice=pricePerNight * nights;
        priceText.innerText=`for ${nights} night${nights !== 1 ? "s" : ""}`;
    }
}
updateBooking();


checkIn.addEventListener("change", () => {
    const nextDay = new Date(checkIn.value);
    nextDay.setDate(nextDay.getDate() + 1);
    //make checkout at least one day after check-in:
    checkOut.min = nextDay.toISOString().split("T")[0];

    if (checkOut.value < checkOut.min) {
        checkOut.value = checkOut.min;
        sessionStorage.setItem("checkOut",checkOut.value);
    }
    sessionStorage.setItem("checkIn",checkIn.value);
    sessionStorage.setItem("checkOut",checkOut.value);

    updateBooking();
});

checkOut.addEventListener("change",()=>{
    sessionStorage.setItem("checkIn",checkIn.value);
    sessionStorage.setItem("checkOut",checkOut.value);
    updateBooking();
});

//implementing rozarpay functionality
   
   async function payNow() {
      
    try {
            const response = await axios.post(
                "/listings/<%= listing._id %>/create-order",
                {
                    booking: {
                        checkIn:checkIn.value,
                        checkOut:checkOut.value,
                        guests:guests.value
                    }
                }
            );

            const order = response.data;
            

            const options = {
                key: "<%= process.env.RAZORPAY_KEY_ID %>", 
                amount: order.amount,
                currency: order.currency,
                name: "WanderLust",
                description: "Booking Payment",
                order_id: order.id,

                handler: async function (response) {
                   
                    try {
                         const res = await axios.post("/payment/verify",
                        {
                            ...response,
                            listingId: "<%= listing._id %>",
                            booking: {
                                checkIn: checkIn.value,
                                checkOut: checkOut.value,
                                guests: guests.value
                            }
                        });

                        if (res.data.success) {
                            //Browser session (sessionStorage) this is not express session its different
                            //This lives in the browser.
                            sessionStorage.setItem("flashSuccess", res.data.message);
                            
                            //what happens after redirect that code is written at bottom
                            //we will retrieve message from session and pass in window.flashSuccess
                            window.location.href = res.data.redirectUrl;
                            
                        }
                       

                    } catch (error) {
                        throw error;
                    }
                   
                },

                prefill: {
                    name: "<%= currUser ? currUser.username : '' %>",
                    email: "<%= currUser ? currUser.email : '' %>",
                    
                },

                theme: {
                    color: "#FF385C"
                }
            };

            const rzp = new Razorpay(options);
            rzp.open();
        } catch (err) {
            throw err;
        }
    }

    function openBookingLoginModal() {
        
            const modalElement = document.getElementById("signupModal");

        document
            .querySelector(".modal-content")
            .classList.add("active");

        const modal = new bootstrap.Modal(modalElement);
        modal.show();
    }



    document.getElementById("bookingForm").addEventListener("submit", async (e) => {
        e.preventDefault();
            try {
               
                await payNow();
            }catch (err) {
                if (
                    err.response?.status === 401 &&
                    err.response.data.openLoginModal
                ) {
                    openBookingLoginModal();
                    return;
                }

          
   
    }
    });
//now message is shifted to bookings.ejs
    // const message = sessionStorage.getItem("flashSuccess");

   // if (message) {
        //window.flashSuccess = message;
        //sessionStorage.removeItem("flashSuccess");
    //}

</script>