            </div>

            <div class="toggle-panel toggle-right">
               
                    <img
                    src="https://res.cloudinary.com/lxlylk0n/image/upload/v1792675850/whitelogo_ywhgg9.png"
                    class="auth-logo"
                    alt=""
                    >
                <h4 class="brand-name">WanderLust</h4>
              
                <div class="mt-4 mb-4"></div>
               
                <h1>Start Your Journey!</h1>

                <p> Create your Wanderlust account to discover unique stays, 
                    unforgettable destinations, and your next adventure. </p>

                <img
                    src="https://res.cloudinary.com/lxlylk0n/image/upload/v1792675849/mountains_toaoqd.png"
                    class="auth-landscape"
                    alt=""
                >
            </div>
        </div>
